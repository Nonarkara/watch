{
  "name": "watch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build_rolex_catalog.mjs && node scripts/build_screen_sightings.mjs && node scripts/build_indices.mjs && node scripts/build_auction_census.mjs && node scripts/build_sitemap.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "test:security": "node scripts/test-security.mjs",
    "posttest": "npm run test:security",
    "preview": "vite preview",
    "verify:experience": "node scripts/verify-experience.mjs",
    "data:build": "node scripts/build_indices.mjs",
    "data:sitemap": "node scripts/build_sitemap.mjs",
    "data:census": "node scripts/build_auction_census.mjs",
    "data:fx": "node scripts/fx_convert_market.mjs --write",
    "data:match": "node scripts/match_fuzzy_phillips.mjs --write",
    "data:promote": "node scripts/apply_fuzzy_phillips.mjs",
    "data:catalog": "node scripts/build_rolex_catalog.mjs",
    "data:screen": "node scripts/build_screen_sightings.mjs",
    "data:screen:harvest": "node scripts/collect_watch_id.mjs",
    "data:market:harvest": "node scripts/collect_phillips_sales.mjs",
    "data:market:promote": "node scripts/promote_market_sale.mjs",
    "test": "node scripts/test-invariants.mjs && node scripts/test-routes.mjs && node scripts/test-evidence-field.mjs && node scripts/test-attention-pulse.mjs && node scripts/test-value-lab.mjs && node scripts/test-venues.mjs && node scripts/test-css-theme.mjs && node scripts/test-market-harvest.mjs && node scripts/test-live-pipeline.mjs",
    "data:audit": "node scripts/audit.mjs",
    "data:sightings:validate": "node scripts/validate_sightings.mjs",
    "data:cpi": "node scripts/collect-cpi.mjs",
    "data:trends": "node scripts/collect_market_trends.mjs",
    "data:status": "node scripts/data-status.mjs",
    "live:run": "node worker/live/run-local.mjs",
    "data:city": "node scripts/build_city_model.mjs",
    "deploy": "npm run build && npm test && npx wrangler pages deploy dist --project-name watch --branch main"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
