{
  "name": "watch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build_rolex_catalog.mjs && node scripts/build_screen_sightings.mjs && node scripts/build_indices.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "data:build": "node scripts/build_indices.mjs",
    "data:catalog": "node scripts/build_rolex_catalog.mjs",
    "data:screen": "node scripts/build_screen_sightings.mjs",
    "data:screen:harvest": "node scripts/collect_watch_id.mjs",
    "test": "node scripts/test-invariants.mjs && node scripts/test-routes.mjs && node scripts/test-evidence-field.mjs",
    "data:audit": "node scripts/audit.mjs",
    "data:sightings:validate": "node scripts/validate_sightings.mjs",
    "data:cpi": "node scripts/collect-cpi.mjs",
    "data:status": "node scripts/data-status.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
